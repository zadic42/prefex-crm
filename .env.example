# MySQL / MariaDB root password
MYSQL_ROOT_PASSWORD=change_this_root_password

# Database name for Perfex CRM
MYSQL_DATABASE=perfex_db

# Database username
MYSQL_USER=perfex

# Database user password
MYSQL_PASSWORD=change_this_password

# Base site URL for Perfex CRM (with trailing slash)
APP_BASE_URL=https://crm.supportzone.ae/

# Encryption Key (CodeIgniter encryption key)
APP_ENC_KEY=change_this_32_char_encryption_key
